// ============================================================
//  firestore.rules
//  Paste the rules block below into:
//  Firebase Console → Firestore Database → Rules
// ============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── admin check ────────────────────────────────────────────
    // Single hardcoded owner/admin UID. Grants read/list/delete
    // access across collections for the admin dashboard. Does NOT
    // grant Firebase Auth account deletion (that still needs the
    // Admin SDK / a local Node script) — this only covers Firestore
    // data (profiles, letters, usernames, referrals).
    function isAdmin() {
      return request.auth != null &&
        request.auth.uid == 'yal0GiGvl8Qo43LNp2eMif5wzM52';
    }

    // ── users collection ──────────────────────────────────────
    // Public read (needed for username lookups on public page)
    // Only the owner can write their own profile
    match /users/{userId} {
      // photoData is a client-compressed base64 JPEG data URL (no Firebase
      // Storage on the free/Spark plan). It's optional — sanity-check its
      // type/size when present, but don't require it.
      function isValidPhoto() {
        return !("photoData" in request.resource.data) ||
          request.resource.data.photoData == null ||
          (request.resource.data.photoData is string &&
           request.resource.data.photoData.size() < 300000);
      }

      allow read:   if true;
      allow create: if request.auth != null && request.auth.uid == userId && isValidPhoto();
      allow update: if request.auth != null && request.auth.uid == userId && isValidPhoto();
      allow delete: if (request.auth != null && request.auth.uid == userId) || isAdmin();
    }

    // ── usernames collection ──────────────────────────────────
    // Public read for uniqueness check during signup
    // Authenticated users can reserve a username (create only)
    match /usernames/{username} {
      allow read:   if true;
      allow create: if request.auth != null;
      allow update: if false;
      allow delete: if (request.auth != null && resource.data.uid == request.auth.uid) || isAdmin();
    }

    // ── referral code lookup ─────────────────────────────────
    // Public read lets signup resolve ?ref=CODE. Users can create/delete
    // only their own code mapping from the client-only GitHub Pages app.
    match /referralCodes/{code} {
      allow read: if true;
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.code == code;
      allow update: if false;
      allow delete: if (request.auth != null && resource.data.uid == request.auth.uid) || isAdmin();
    }

    // ── referrals collection ─────────────────────────────────
    // Each referred account gets one document keyed by its uid. Referrers
    // can read their incoming referrals for dashboard progress.
    match /referrals/{referralId} {
      allow create: if request.auth != null &&
        referralId == request.auth.uid &&
        request.resource.data.referredUid == request.auth.uid &&
        request.resource.data.referrerUid is string &&
        request.resource.data.referrerUid != request.auth.uid &&
        request.resource.data.referrerCode is string &&
        exists(/databases/$(database)/documents/referralCodes/$(request.resource.data.referrerCode)) &&
        get(/databases/$(database)/documents/referralCodes/$(request.resource.data.referrerCode)).data.uid ==
          request.resource.data.referrerUid;
      allow read: if request.auth != null &&
        (resource.data.referrerUid == request.auth.uid ||
         resource.data.referredUid == request.auth.uid ||
         isAdmin());
      allow update: if false;
      allow delete: if (request.auth != null &&
        (resource.data.referrerUid == request.auth.uid ||
         resource.data.referredUid == request.auth.uid)) || isAdmin();
    }

    // ── messages collection ───────────────────────────────────
    match /messages/{messageId} {

      // Anyone can send a message (no login required to write)
      allow create: if
        request.resource.data.keys().hasAll([
          'toUserId', 'text', 'isAnonymous', 'deleteToken'
        ]) &&
        request.resource.data.deleteToken == messageId &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 2500 &&
        request.resource.data.isAnonymous is bool &&
        request.resource.data.deleteToken is string;

      // The recipient can list/read their own inbox. Senders can only
      // open the exact token document used by the unsend page.
      allow get: if
        (request.auth != null && resource.data.toUserId == request.auth.uid) ||
        resource.data.deleteToken == messageId ||
        isAdmin();

      // Allow public counting for stats (unauthenticated users can count messages)
      // Authenticated users can list their own messages for inbox
      // Admin can list/browse every letter for moderation
      allow list: if request.auth == null ||
        (request.auth != null && resource.data.toUserId == request.auth.uid) ||
        isAdmin();

      // Only the recipient can delete from the dashboard
      allow delete: if
        (request.auth != null && resource.data.toUserId == request.auth.uid) ||
        resource.data.deleteToken == messageId ||
        isAdmin();

      // The recipient can update inbox-only metadata without changing the
      // original letter text, sender, token, or owner.
      allow update: if
        request.auth != null &&
        resource.data.toUserId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isRead', 'isFavorite', 'isReported', 'replyText', 'repliedAt', 'receiverReaction'
        ]) &&
        (!request.resource.data.keys().hasAny(['isRead']) ||
          request.resource.data.isRead is bool) &&
        (!request.resource.data.keys().hasAny(['isFavorite']) ||
          request.resource.data.isFavorite is bool) &&
        (!request.resource.data.keys().hasAny(['isReported']) ||
          request.resource.data.isReported is bool) &&
        (!request.resource.data.keys().hasAny(['replyText']) ||
          (request.resource.data.replyText is string &&
           request.resource.data.replyText.size() <= 280)) &&
        (!request.resource.data.keys().hasAny(['receiverReaction']) ||
          request.resource.data.receiverReaction in ['', 'heart', 'smile', 'cry', 'spark']);
    }
  }
}

// ────────────────────────────────────────────────────────────
//  NOTE: Sender "Unsend" Feature
//
//  The token-based delete (delete.html?token=XYZ) works by
//  storing each message under its delete token as the document ID.
//  That lets the sender read/delete only that exact document link
//  without opening up the rest of the messages collection.
//
//  Anyone who knows the token can still unsend that one message,
//  so treat the delete link like a secret.
// ────────────────────────────────────────────────────────────
