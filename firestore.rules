// ============================================================
//  firestore.rules
//  Paste the rules block below into:
//  Firebase Console → Firestore Database → Rules
// ============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── users collection ──────────────────────────────────────
    match /users/{userId} {
      allow read:   if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ── usernames collection ──────────────────────────────────
    match /usernames/{username} {
      allow read:   if true;
      allow create: if request.auth != null;
      allow update: if false;
      allow delete: if request.auth != null;
    }

    // ── messages collection ───────────────────────────────────
    match /messages/{messageId} {

      // Anyone can send a message (no login required to write)
      allow create: if
        request.resource.data.keys().hasAll([
          'toUserId', 'text', 'isAnonymous', 'deleteToken'
        ]) &&
        request.resource.data.deleteToken == messageId &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 2500 &&
        request.resource.data.isAnonymous is bool &&
        request.resource.data.deleteToken is string;

      // Recipient can read their own. Sender can read via token.
      allow get: if
        (request.auth != null && resource.data.toUserId == request.auth.uid) ||
        resource.data.deleteToken == messageId;

      // Allow public counting + recipient listing
      allow list: if request.auth == null ||
        (request.auth != null && resource.data.toUserId == request.auth.uid);

      // Recipient or token-holder can delete
      allow delete: if
        (request.auth != null && resource.data.toUserId == request.auth.uid) ||
        resource.data.deleteToken == messageId;

      // Recipient can update inbox metadata only
      allow update: if
        request.auth != null &&
        resource.data.toUserId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isRead', 'isFavorite', 'isReported', 'replyText', 'repliedAt', 'receiverReaction', 'replierName'
        ]) &&
        (!request.resource.data.keys().hasAny(['isRead']) ||
          request.resource.data.isRead is bool) &&
        (!request.resource.data.keys().hasAny(['isFavorite']) ||
          request.resource.data.isFavorite is bool) &&
        (!request.resource.data.keys().hasAny(['isReported']) ||
          request.resource.data.isReported is bool) &&
        (!request.resource.data.keys().hasAny(['replyText']) ||
          (request.resource.data.replyText is string &&
           request.resource.data.replyText.size() <= 280)) &&
        (!request.resource.data.keys().hasAny(['receiverReaction']) ||
          request.resource.data.receiverReaction in ['', 'heart', 'smile', 'cry', 'spark']);
    }
  }
}
